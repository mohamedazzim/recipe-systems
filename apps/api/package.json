{
  "name": "@recipe-systems/api",
  "version": "0.2.0",
  "private": true,
  "description": "NestJS API / BFF — the only service browsers call (SCAFFOLD §3). Reconciled: Keycloak OIDC via adapter seam, Prisma via @recipe-systems/database.",
  "scripts": {
    "dev": "npm run build -w @recipe-systems/database && nest start --watch",
    "build": "npm run build -w @recipe-systems/database && nest build",
    "start": "npm run build -w @recipe-systems/database && node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "contracts:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@recipe-systems/database": "*",
    "@recipe-systems/llm-adapter": "*",
    "@recipe-systems/schemas": "*",
    "cookie-parser": "^1.4.7",
    "jose": "^5.9.6",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.30.0"
  }
}
