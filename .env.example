# Recipe Systems — local development environment (dev secrets only; production uses a managed secrets store, never .env — Tech Stack §16)

# API / BFF
PORT=3001
CORS_ORIGINS=http://localhost:3000
# Browser app origin the BFF redirects to after login/callback (success and failure)
WEB_ORIGIN=http://localhost:3000

# Postgres — the compose core profile maps host 5433 (native Windows PostgreSQL owns 5432 on dev machines)
DATABASE_URL=postgresql://recipe:recipe_dev_password@localhost:5433/recipe

# Session (BFF-issued session JWT, HS256). DEV DEFAULT ONLY — production must inject a strong secret.
SESSION_SECRET=dev-session-secret-change-me
SESSION_TTL_SECONDS=900
# Secure flag on session cookies. Keep `true` (Tech Stack §14). Browsers accept Secure cookies
# on http://localhost; non-browser E2E tools (curl/requests) need `false` for plain-HTTP runs.
SESSION_SECURE=true

# Keycloak — the sole identity provider (Q8 RESOLVED; SCAFFOLD §3). Realm: recipesystems.
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=recipesystems
KEYCLOAK_CLIENT_ID=recipe-systems-bff
KEYCLOAK_CLIENT_SECRET=dev-bff-client-secret-change-me
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/recipesystems
# Redirect back to the BFF after the authorization-code flow
AUTH_REDIRECT_BASE=http://localhost:3001

# Object storage (dev MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=recipe-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Worker (pg-boss) — analysis jobs
DATABASE_URL_WORKER=postgresql://recipe:recipe_dev_password@localhost:5433/recipe

# LLM adapter — Q9 provider switch (2026-09-11): MODEL_PROVIDER is the
# canonical selection knob (gemini | deepseek); the deterministic mock/stub is
# used by CI/tests (no provider is set there, no key is required). Keys are
# server-side only: never committed, never sent to the browser, never exposed
# by the API.
MODEL_PROVIDER=gemini
LLM_PROVIDER=gemini

# Gemini (current provider). API credential — keep ONLY in the local
# environment / secret store.
GEMINI_API_KEY=

# Gemini model id (verified via GET /v1beta/models, e.g. gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# Official thinking level — sent as generationConfig.thinkingConfig.thinkingLevel
# (gemini-3.8-flash supports low/medium/high; unknown values are dropped and the
# provider default applies).
GEMINI_THINKING_LEVEL=low

# Official Gemini API base URL.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional server-side request controls. Gemini default maxRetries=8 (bounded,
# Retry-After-aware, ~16s backoff cap): gemini-3.8-flash launched under high
# demand with intermittent 503/429 throttle windows (live-verified 2026-09-11).
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=8

# DeepSeek (kept available as a provider implementation — MODEL_PROVIDER=deepseek).
# API credential — keep ONLY in the local environment / secret store.
DEEPSEEK_API_KEY=

# Use the exact DeepSeek model ID supported by your account/API
# (verified at preflight via GET /models: deepseek-flash, deepseek-v4-pro).
DEEPSEEK_MODEL=deepseek-v4-pro

# Standard DeepSeek API base URL.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional server-side request controls (conservative defaults).
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRIES=2

# Development feature switch: 1 forces the deterministic stub (explicit
# determinism wins over MODEL_PROVIDER).
ANALYSIS_LLM_STUB=0

# OCR adapter — text extraction provider (gemini | deepseek | paddle | stub |
# disabled). gemini uses the GEMINI_API_KEY above; no per-line confidence, so
# missing-confidence lines follow the conservative needs_review policy.
OCR_PROVIDER=gemini
